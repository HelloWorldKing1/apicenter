    <sec:SecurityHostedUser>
      <sec:UserID POS_Type="1" PseudoCityCode="OFFICE" AgentDutyCode="SU" RequestorType="U"/>
    </sec:SecurityHostedUser>
  </SOAP-ENV:Header>
  <SOAP-ENV:Body>
    <op:Retrieve><op:id>ABC123</op:id></op:Retrieve>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
