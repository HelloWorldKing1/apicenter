<?xml version="1.0" encoding="UTF-8"?>
<!-- 合成夹具：值全部为假值（形态取自真实企业级报文，见 README） -->
<!-- 家族③-a：厂商会话头（前缀形式）—— 登录一次拿 SessionId/SecurityToken，后续请求带上；值静态或半静态 -->
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
                   xmlns:ses="http://example.com/svc/Session-2.0.xsd"
                   xmlns:op="http://example.com/svc/Retrieve-1.0">
  <SOAP-ENV:Header>
    <ses:Session>
      <ses:SessionId>ABCDEFGHIJKLM</ses:SessionId>
      <ses:SequenceNumber>13</ses:SequenceNumber>
      <ses:SecurityToken>0000000000000000000000000000</ses:SecurityToken>
    </ses:Session>
  </SOAP-ENV:Header>
  <SOAP-ENV:Body>
    <op:Retrieve><op:type>2</op:type><op:id>ABC123</op:id></op:Retrieve>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
