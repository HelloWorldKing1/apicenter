<?xml version="1.0" encoding="UTF-8"?>
<!-- 合成夹具：值全部为假值（形态取自真实企业级报文，见 README） -->
<!-- 家族①：WS-Addressing 1.0 —— 静态/半静态头（MessageID 每次请求可变，Action/To 基本固定） -->
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
  <SOAP-ENV:Header>
    <wsa:MessageID xmlns:wsa="http://www.w3.org/2005/08/addressing">00000000-0000-4000-8000-000000000000</wsa:MessageID>
    <wsa:Action xmlns:wsa="http://www.w3.org/2005/08/addressing">http://example.com/svc/Retrieve-1.0</wsa:Action>
    <wsa:To xmlns:wsa="http://www.w3.org/2005/08/addressing">https://dummy.endpoint/SERVICE</wsa:To>
  </SOAP-ENV:Header>
  <SOAP-ENV:Body>
    <Retrieve xmlns="http://example.com/svc/Retrieve-1.0"><id>ABC123</id></Retrieve>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
